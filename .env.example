# Copie este arquivo para .env e preencha SOMENTE no seu computador.
# Nunca cole a chave no chat nem inclua .env na entrega.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Consulte os modelos disponíveis na sua conta pelo botão do aplicativo.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=90
# Modelos reserva, em ordem, se o principal estiver sobrecarregado.
LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest
# Modelo local pelo Ollama (https://ollama.com), sem internet: ollama pull qwen2.5:3b
# Com LLM_PROVIDER=gemini, ele assume quando o Gemini estiver sem conexão.
# Com LLM_PROVIDER=ollama, ele é o modelo principal e a mensagem não sai do computador.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
